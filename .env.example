# ============================================================================
# EPEP - Election Process Education Platform
# Environment Configuration
# Rename this file to .env and fill in your values
# ============================================================================

# -- OpenRouter (AI chat fallback chain) -------------------------------------
# Get free key at: https://openrouter.ai
# Used for: Gemma 3 27B, Llama 4, DeepSeek R2 fallback models
VITE_OPENROUTER_API_KEY=your_openrouter_key_here

# -- Google Gemini AI (Layer 1 - Primary AI model) ---------------------------
# Get free key at: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1M tokens/day
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# -- Firebase Analytics (Google Services) ------------------------------------
# Setup: https://console.firebase.google.com
# 1. Create project: "epep-promptwars"
# 2. Add web app and copy config below
# 3. Enable Google Analytics
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=epep-promptwars.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=epep-promptwars
VITE_FIREBASE_STORAGE_BUCKET=epep-promptwars.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================================
# WITHOUT ANY KEY, these features still work:
# - Interactive India Map (Leaflet + GeoJSON)
# - EVM Simulator (complete 6-step voting flow)
# - Education Hub
# - Quiz (question pool, scoring, grades)
# - Dashboard historical trends
# - PWA offline mode
# - AI Chat local database fallback
# - Analytics disabled gracefully
# ============================================================================
